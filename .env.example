SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional production/site origin.
# SITE_URL=http://localhost:3000

# Phase 5: generate a random 32-byte key and base64 encode it.
# Keep this server-only and never expose it with NEXT_PUBLIC_.
# SOCIAL_OAUTH_ENCRYPTION_KEY=

# Social OAuth provider credentials. Keep all values server-only.
# Meta (Facebook + Instagram)
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=
# FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement
# INSTAGRAM_OAUTH_SCOPES=instagram_basic
# FACEBOOK_PROFILE_URL=
# INSTAGRAM_PROFILE_URL=

# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social

# X
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_OAUTH_SCOPES=users.read tweet.read offline.access

# YouTube / Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly

# TikTok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_OAUTH_SCOPES=user.info.basic

# Phase 8D: secret used to authorize the scheduled publishing worker.
# CRON_SECRET=

# Canonical site origin. Required in production.
# SITE_URL=http://localhost:3000

# Email notifications
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Phase 5: generate a random 32-byte key and base64 encode it.
# Keep this server-only and never expose it with NEXT_PUBLIC_.
# SOCIAL_OAUTH_ENCRYPTION_KEY=

# Social OAuth provider credentials. Keep all values server-only.
# Meta (Facebook + Instagram)
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=
# FACEBOOK_OAUTH_SCOPES=pages_manage_metadata,pages_manage_posts,pages_manage_read_engagement,pages_show_list
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish
# FACEBOOK_PROFILE_URL=https://graph.facebook.com/<version>/me?fields=id,name
# INSTAGRAM_PROFILE_URL=https://graph.instagram.com/<version>/me?fields=user_id,username,account_type,profile_picture_url

# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social

# X
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_OAUTH_SCOPES=users.read tweet.read tweet.write offline.access

# YouTube / Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload

# TikTok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish

# Phase 8D: secret used to authorize the scheduled publishing worker.
# CRON_SECRET=

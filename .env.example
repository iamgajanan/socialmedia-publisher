SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
SOCIAL_OAUTH_ENCRYPTION_KEY=
OPS_ADMIN_EMAILS=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_FACEBOOK_SCOPES=pages_manage_metadata,pages_manage_posts,pages_manage_read_engagement,pages_show_list
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_SCOPES=threads_basic,threads_content_publish

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social w_organization_social r_organization_admin
LINKEDIN_VERSION=202609

X_CLIENT_ID=
X_CLIENT_SECRET=

# YouTube: Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest API v5 OAuth 2.0.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_OAUTH_SCOPES=user_accounts:read boards:read boards:write pins:read pins:write

# Bluesky OAuth uses a public client metadata URL and DPoP; there is no client secret.
# BLUESKY_CLIENT_ID=https://your-domain.example/api/social/bluesky/client-metadata
BLUESKY_PDS_URL=https://bsky.social

# Google Business Profile uses the same Google OAuth client as YouTube but a separate redirect URI.
# Required scope: https://www.googleapis.com/auth/business.manage

# Reddit OAuth Web App credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_OAUTH_SCOPES=identity submit read
# Optional default subreddit for Reddit publishing. If omitted, OmniSocial uses the connected user's profile feed.
REDDIT_DEFAULT_SUBREDDIT=

# Canonical site origin. Required in production.
SITE_URL=http://localhost:3000

# Stripe billing - USD only for the current release.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_PREMIUM_USD=
